{%- from "macros/box.njk" import box -%}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} :: {% endif %}{{ site.title }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DotGothic16&family=Noto+Sans+JP:wght@400;700&display=swap">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="page">

  <header class="masthead">
    <div class="masthead-title">
      <a href="/">{{ site.title }}</a>
      <span class="tagline">{{ site.tagline }}</span>
    </div>
    <div class="masthead-meta">
      最終更新 / Last updated: <b>{{ page.date | ymd }}</b>
    </div>
  </header>

  <nav class="tabs">
    {%- for item in site.nav %}
    <a href="{{ item.url }}"{% if page.url == item.url %} class="on"{% endif %}>{{ item.label }}</a>
    {%- endfor %}
  </nav>

  <aside class="col-left">
    {% call box("■ Menu") %}
      <ul class="menu">
        {%- for item in site.nav %}
        <li><a href="{{ item.url }}">▶ {{ item.label }}</a></li>
        {%- endfor %}
      </ul>
    {% endcall %}
    {% call box("■ Profile") %}
      <p><b>{{ site.author }}</b></p>
      <dl class="kv">
        <dt>Printer</dt><dd>Prusa MK4IS</dd>
        <dt>Likes</dt><dd>minis, PETG, dense websites</dd>
      </dl>
    {% endcall %}
  </aside>

  <main class="col-main">
    {{ content | safe }}
  </main>

  <aside class="col-right">
    {%- set nowSteam = media.steam.recent.slice(0, 3) if media.steam.ok else [] %}
    {%- set nowAni = media.anilist.watching.slice(0, 3) if media.anilist.ok else [] %}
    {%- if nowSteam.length or nowAni.length %}
    {% call box("■ Now") %}
      <ul class="now">
        {%- for g in nowSteam %}
        <li><span class="tag">PLAY</span> <a href="{{ g.url }}">{{ g.name }}</a> <span class="small">{{ g.hours2wk }}h/2wk</span></li>
        {%- endfor %}
        {%- for e in nowAni %}
        <li><span class="tag tag-ani">WATCH</span> <a href="{{ e.url }}">{{ e.title }}</a> <span class="small">ep {{ e.progress }}{% if e.total %}/{{ e.total }}{% endif %}</span></li>
        {%- endfor %}
      </ul>
      <p class="more"><a href="/media/">» media log</a></p>
    {% endcall %}
    {%- endif %}
    {% call box("■ 最新情報 / Updates") %}
      <ul class="updates">
        {%- for u in updates %}
        <li><span class="date">{{ u.date | ymd }}</span> {{ u.text }}{% if u.new %} <span class="new">NEW!</span>{% endif %}</li>
        {%- endfor %}
      </ul>
    {% endcall %}
    {% call box("■ Links") %}
      {%- for g in links %}
      <p class="link-group">{{ g.group }}</p>
      <ul class="links">
        {%- for l in g.items %}
        <li>・<a href="{{ l.url }}">{{ l.label }}</a></li>
        {%- endfor %}
      </ul>
      {%- endfor %}
    {% endcall %}
    {% call box("■ Counter") %}
      <p class="counter">{{ site.counter }}</p>
      <p class="small">※ decorative, not a real counter</p>
    {% endcall %}
  </aside>

  <footer class="footer">
    Copyright &copy; {{ page.date | ymd | truncate(4, true, "") }} {{ site.author }}. All rights reserved.
    ｜ Best viewed at 1024×768 (or anything, really).
  </footer>

</div>
</body>
</html>
